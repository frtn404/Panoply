generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
enum Role {
  customer
  provider
  admin
}
model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  phone     String?
  password  String
  role      Role     @default(customer)
  createdAt DateTime @default(now())
}