{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install && ./node_modules/.bin/prisma generate"
    },
    "deploy": {
        "startCommand": "node src/server.js",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
    
}
